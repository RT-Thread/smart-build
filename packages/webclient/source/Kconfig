config PKGS_DIR
    string
    option env="PKGS_ROOT"
    default "packages"

config RT_VER_NUM
    hex
    default 0x50100

menu "webclient"

config PACKAGE_WEBCLIENT
    bool "Enable webclient"
    help
      Independent RT-Thread SCons webclient HTTP client example
    select PKG_USING_WEBCLIENT

source "$PKGS_DIR/Kconfig"

endmenu
