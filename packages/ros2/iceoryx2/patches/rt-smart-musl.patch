diff --git a/iceoryx2-pal/posix/src/linux/fcntl.rs b/iceoryx2-pal/posix/src/linux/fcntl.rs
--- a/iceoryx2-pal/posix/src/linux/fcntl.rs
+++ b/iceoryx2-pal/posix/src/linux/fcntl.rs
@@ -45,7 +45,27 @@ pub unsafe fn fcntl2(fd: int, cmd: int) -> int {
     unsafe { libc::fcntl(fd, cmd) }
 }
 
 pub unsafe fn fchmod(fd: int, mode: mode_t) -> int {
-    unsafe { libc::fchmod(fd, mode) }
+    #[cfg(rt_smart)]
+    {
+        const RT_SMART_FCHMOD_SYSCALL: libc::c_long = 215;
+        let result = unsafe {
+            libc::syscall(
+                RT_SMART_FCHMOD_SYSCALL,
+                fd as libc::c_long,
+                mode as libc::c_long,
+            )
+        };
+        if result < 0 {
+            unsafe { *libc::__errno_location() = -result as int };
+            -1
+        } else {
+            result as int
+        }
+    }
+    #[cfg(not(rt_smart))]
+    unsafe {
+        libc::fchmod(fd, mode)
+    }
 }
 
