PACKAGE_MC=y
PACKAGE_NANO=y
PACKAGE_NCURSES=y
PACKAGE_NCURSES_VERSION=6.6
PACKAGE_OPENSSL=y
PACKAGE_OPENSSL_VERSION=3.5.7
PACKAGE_PCRE2=y
PACKAGE_PCRE2_VERSION=10.47
PACKAGE_QUICKJS=y
PACKAGE_QUICKJS_VERSION=2026-06-04
PACKAGE_READLINE=y
PACKAGE_READLINE_VERSION=8.3
PACKAGE_TINYSSH=y
PACKAGE_TMUX=y
