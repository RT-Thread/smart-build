ROOTFS=full
ROOTFS_BUILD_MODE=mixed
ROOTFS_PROFILE=full
ROOTFS_IMAGE_FORMAT=ext4
ROOTFS_IMAGE_SIZE_MB=16
ROOTFS_IMAGE_SIZE_MODE=expandable
ROOTFS_PACKAGE_MODE=manual
TOOLCHAIN=riscv64-linux-musleabi-gcc-latest
