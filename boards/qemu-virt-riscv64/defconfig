PACKAGE_LIBFFI=y
PACKAGE_LIBFFI_VERSION=3.5.2
PACKAGE_LIBGLIB2=y
PACKAGE_LIBICONV=y
PACKAGE_LIBICONV_VERSION=1.17
PACKAGE_LUA=y
